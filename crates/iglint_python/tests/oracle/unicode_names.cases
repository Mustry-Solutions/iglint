### name ascii
x = u'\N{LATIN CAPITAL LETTER A}'
### name bullet
x = u'\N{BULLET}'
### name lowercase
x = u'\N{bullet}'
### name mixed case
x = u'\N{Latin Small Letter Sharp S}'
### name control
x = u'\N{NULL}\N{FORM FEED (FF)}\N{CHARACTER TABULATION}'
### name hyphenated
x = u'\N{SINGLE LOW-9 QUOTATION MARK}\N{GREATER-THAN SIGN}'
### name leading hyphen word
x = u'\N{TIBETAN MARK GTER YIG MGO -UM RNAM BCAD MA}'
### name greek and cyrillic
x = u'\N{GREEK SMALL LETTER ALPHA}\N{CYRILLIC CAPITAL LETTER ZHE}'
### name hebrew and arabic
x = u'\N{HEBREW LETTER ALEF}\N{ARABIC LETTER BEH}'
### name devanagari
x = u'\N{DEVANAGARI LETTER KA}'
### name thai
x = u'\N{THAI CHARACTER KO KAI}'
### name hangul jamo
x = u'\N{HANGUL CHOSEONG KIYEOK}'
### name yi syllable
x = u'\N{YI SYLLABLE IT}'
### name cjk radical
x = u'\N{CJK RADICAL REPEAT}'
### name halfwidth
x = u'\N{HALFWIDTH KATAKANA LETTER A}'
### name astral emoji
x = u'\N{PILE OF POO}'
### name astral musical
x = u'\N{BYZANTINE MUSICAL SYMBOL FHTORA SKLIRON CHROMA VASIS}'
### name astral math
x = u'\N{MATHEMATICAL BOLD CAPITAL A}'
