### import single
import os
### import dotted
import os.path
### import as
import os.path as p
### import multiple
import os, sys as s, a.b.c
### from import
from os import path
### from import as
from os import path as p, sep
### from import parenthesized
from os import (path, sep)
### from import parenthesized trailing comma
from os import (path, sep,)
### from import star
from os import *
### from relative
from . import x
### from relative module
from .mod import x
### from relative two
from .. import x
### from relative three dots
from ... import x
### from relative dotted
from ..a.b import c as d
### from dotted
from a.b.c import d
### future print function
from __future__ import print_function
print(1, 2, sep='', end='')
### future unicode literals
from __future__ import unicode_literals
x = 'a'
y = b'b'
z = r'c'
### future multiple
from __future__ import absolute_import, division, print_function
### future parenthesized
from __future__ import (print_function)
print(x)
