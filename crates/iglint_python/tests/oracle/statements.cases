x = yield 1, 2
### assign yield chain
a = b = yield c
### assign parenthesized yield first
(a) = yield x
### augmented assignments
x += 1
x -= 1
x *= 1
x /= 1
x %= 1
x &= 1
x |= 1
x ^= 1
x <<= 1
x >>= 1
x **= 1
x //= 1
