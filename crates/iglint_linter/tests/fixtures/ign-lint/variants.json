{
  "_comment": "Each variant is a complete ign-lint rule_config.json. 'default' is the empty config: every registered rule runs with its default kwargs (PropertyAccessRule and PropertyPersistenceRule are inert by default). Every other variant enables exactly one rule. Most kwargs are taken verbatim from ign-lint's own tests; see docs/compat/ign-lint-tests.md.",
  "_exclude": {"ecd-tight": ["cases/BadContextData"]},
  "default": {},
  "np-pascal-component-error": {"NamePatternRule": {"kwargs": {"target_node_types": ["component"], "convention": "PascalCase", "allow_numbers": true, "min_length": 1, "severity": "error"}}},
  "np-camel-component-error": {"NamePatternRule": {"kwargs": {"target_node_types": ["component"], "convention": "camelCase", "allow_numbers": true, "min_length": 1, "severity": "error"}}},
  "np-snake-component-error": {"NamePatternRule": {"kwargs": {"target_node_types": ["component"], "convention": "snake_case", "allow_numbers": true, "min_length": 1, "severity": "error"}}},
  "np-kebab-component": {"NamePatternRule": {"kwargs": {"target_node_types": ["component"], "convention": "kebab-case", "allow_numbers": true, "min_length": 1}}},
  "np-screaming-component": {"NamePatternRule": {"kwargs": {"target_node_types": ["component"], "convention": "SCREAMING_SNAKE_CASE"}}},
  "np-title-component": {"NamePatternRule": {"kwargs": {"target_node_types": ["component"], "convention": "Title Case"}}},
  "np-lower-component": {"NamePatternRule": {"kwargs": {"target_node_types": ["component"], "convention": "lower case"}}},
  "np-convention-only": {"NamePatternRule": {"kwargs": {"convention": "PascalCase"}}},
  "np-target-string": {"NamePatternRule": {"kwargs": {"target_node_types": "component", "convention": "PascalCase"}}},
  "np-property-camel": {"NamePatternRule": {"kwargs": {"target_node_types": ["property"], "convention": "camelCase"}}},
  "np-component-custom-method-camel-min3": {"NamePatternRule": {"kwargs": {"target_node_types": ["component", "custom_method"], "convention": "camelCase", "min_length": 3}}},
  "np-standard-component-property": {"NamePatternRule": {"kwargs": {"target_node_types": ["component", "property"], "convention": "PascalCase", "node_type_specific_rules": {"component": {"convention": "PascalCase", "min_length": 1, "allow_numbers": true}, "property": {"convention": "camelCase", "min_length": 1, "allow_numbers": true, "skip_names": ["id", "x", "y", "z"]}}}}},
  "np-severity-split": {"NamePatternRule": {"kwargs": {"target_node_types": ["component", "property"], "node_type_specific_rules": {"component": {"convention": "PascalCase", "severity": "error"}, "property": {"convention": "camelCase", "severity": "warning"}}}}},
  "np-four-types": {"NamePatternRule": {"kwargs": {"node_type_specific_rules": {"component": {"convention": "PascalCase", "severity": "error"}, "property": {"convention": "camelCase", "severity": "warning"}, "message_handler": {"convention": "kebab-case", "severity": "warning"}, "custom_method": {"convention": "snake_case", "severity": "error"}}}}},
  "np-pascal-min5": {"NamePatternRule": {"kwargs": {"target_node_types": ["component"], "convention": "PascalCase", "min_length": 5}}},
  "np-pascal-max10": {"NamePatternRule": {"kwargs": {"target_node_types": ["component"], "convention": "PascalCase", "min_length": 1, "max_length": 10}}},
  "np-pascal-no-numbers": {"NamePatternRule": {"kwargs": {"target_node_types": ["component"], "convention": "PascalCase", "allow_numbers": false}}},
  "np-pascal-forbidden": {"NamePatternRule": {"kwargs": {"target_node_types": ["component"], "convention": "PascalCase", "forbidden_names": ["Button", "Label", "Panel"]}}},
  "np-pascal-abbrev-no-autodetect": {"NamePatternRule": {"kwargs": {"target_node_types": ["component"], "convention": "PascalCase", "allowed_abbreviations": ["API", "HTTP", "XML"], "auto_detect_abbreviations": false}}},
  "np-pascal-skip-names": {"NamePatternRule": {"kwargs": {"target_node_types": ["component"], "convention": "PascalCase", "skip_names": ["root", "main", "container"]}}},
  "np-custom-pattern-prefix": {"NamePatternRule": {"kwargs": {"target_node_types": ["component"], "custom_pattern": "^(btn|lbl|pnl)[A-Z][a-zA-Z0-9]*$", "min_length": 4, "max_length": 25}}},
  "np-custom-method-camel-forbidden": {"NamePatternRule": {"kwargs": {"target_node_types": ["custom_method"], "convention": "camelCase", "min_length": 3, "forbidden_names": ["method", "function", "temp"]}}},
  "np-message-handler-snake-forbidden": {"NamePatternRule": {"kwargs": {"target_node_types": ["message_handler"], "convention": "snake_case", "min_length": 4, "forbidden_names": ["handler", "msg", "temp"]}}},
  "np-property-camel-forbidden": {"NamePatternRule": {"kwargs": {"target_node_types": ["property"], "convention": "camelCase", "min_length": 2, "forbidden_names": ["temp", "tmp", "test", "data"]}}},
  "np-mixedcase-pattern": {"NamePatternRule": {"kwargs": {"target_node_types": ["component"], "node_type_specific_rules": {"component": {"pattern": "^([A-Z][a-zA-Z0-9]*|[A-Z][A-Z0-9_]*)$", "pattern_description": "PascalCase or SCREAMING_SNAKE_CASE", "suggestion_convention": "PascalCase", "min_length": 3, "severity": "error"}}}}},
  "poll-1000": {"PollingIntervalRule": {"kwargs": {"minimum_interval": 1000}}},
  "poll-5000": {"PollingIntervalRule": {"kwargs": {"minimum_interval": 5000}}},
  "poll-30000": {"PollingIntervalRule": {"kwargs": {"minimum_interval": 30000}}},
  "pylint-e-warning": {"PylintScriptRule": {"kwargs": {"category_mapping": {"F": "error", "E": "warning", "W": "warning", "C": "warning", "R": "warning"}}}},
  "bcr-case-insensitive": {"BadComponentReferenceRule": {"kwargs": {"case_sensitive": false}}},
  "bcr-sibling-only-warning": {"BadComponentReferenceRule": {"kwargs": {"forbidden_patterns": [".getSibling("], "severity": "warning"}}},
  "crv-no-scripts": {"ComponentReferenceValidationRule": {"kwargs": {"validate_scripts": false}}},
  "crv-no-expressions": {"ComponentReferenceValidationRule": {"kwargs": {"validate_expressions": false}}},
  "crv-no-property-bindings": {"ComponentReferenceValidationRule": {"kwargs": {"validate_property_bindings": false}}},
  "ecd-tight": {"ExcessiveContextDataRule": {"kwargs": {"max_array_size": 5, "max_sibling_properties": 5, "max_nesting_depth": 2, "max_data_points": 20, "max_value_length": 50}}},
  "access-private": {"PropertyAccessRule": {"kwargs": {"expected_access": "PRIVATE"}}},
  "access-public": {"PropertyAccessRule": {"kwargs": {"expected_access": "PUBLIC"}}},
  "access-protected-exempt": {"PropertyAccessRule": {"kwargs": {"expected_access": "protected", "exempt_props": ["data", "root.root.children[?].*"]}}},
  "persistence-false": {"PropertyPersistenceRule": {"kwargs": {"expected_persistent": false}}},
  "persistence-true": {"PropertyPersistenceRule": {"kwargs": {"expected_persistent": true}}},
  "persistence-false-no-exempt": {"PropertyPersistenceRule": {"kwargs": {"expected_persistent": false, "exempt_binding_types": []}}}
}
