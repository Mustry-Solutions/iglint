### relative-from-dotdot
global r_error
try:
    from .. import other
except (ImportError, ValueError), e:
    r_error = type(e).__name__
### read-before-and-after-import
global r_before, r_after
try:
    r_before = __package__
except NameError:
    r_before = 'NameError'
import math
try:
    r_after = __package__
except NameError:
    r_after = 'NameError'
### import-in-function-called
def g():
    import math
g()
### import-in-function-not-called
def g():
    import math
### import-in-class
class C:
    import math
### import-in-unqualified-exec
exec "import math"
### import-in-exec-dict
global r_keys
d = {}
exec "import math" in d
r_keys = sorted(k for k in d if k.startswith('__'))
### dunder-import-call
__import__('math')
### dunder-import-call-globals
__import__('math', globals())
### name-assigned-then-import
global r_after
__name__ = 'a.b'
import math
r_after = __package__
### package-assigned-then-import
global r_after
__package__ = 'x'
import math
r_after = __package__
### package-deleted-then-import
global r_after
import math
del __package__
import time
r_after = __package__
### statements-without-import
