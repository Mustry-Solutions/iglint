### no-statements
pass
### assignment
x = 1
### docstring
"""The module docstring."""
x = 1
### import
import math
### import-dotted
import os.path
### import-as
import math as m2
### import-dotted-as
import os.path as p2
### import-two-names
import math, time
### from-import
from math import pi
### from-import-as
from math import pi as p3
### from-import-star
from math import *
### from-future
from __future__ import division
### import-library-module
import pkg.other
### from-library-package
from pkg import other
### import-java-package
import java
### import-java-class-dotted
import java.lang.String
### from-java-package
from java.lang import String
### from-java-as
from java.util import ArrayList as AL
