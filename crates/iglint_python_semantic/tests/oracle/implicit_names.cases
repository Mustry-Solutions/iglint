x = [i for i in range(3)]
y = list(i for i in range(3))
z = dict((i, i) for i in range(3))
s = set([1])
for i in range(2):
    pass
while False:
    pass
try:
    raise ValueError('v')
except ValueError, e:
    pass
finally:
    pass
class CM(object):
    def __enter__(self):
        return 1
    def __exit__(self, *a):
        return False
with CM() as w:
    pass
assert True
del x
f = lambda q: q
def gen():
    yield 1
r_c = [1 for c in gen()]
print >> None, 'out'
