### try-pass
try:
    pass
except E, e:
    a
### try-global
try:
    global g
except E, e:
    a
### try-str
try:
    'doc'
except E, e:
    a
### try-num
try:
    1
except E, e:
    a
### while1
while 1:
    pass
a
### while1-break
while 1:
    break
a
### try-return-finally
def f():
    try:
        return
    finally:
        b
    a
### try-raise-except
def f():
    try:
        raise X
    except:
        b
    a
### try-return-except-else
def f():
    try:
        return
    except:
        pass
    else:
        c
    a
### for-else-return
def f():
    for x in y:
        return
    else:
        return
    a
### with-return
def f():
    with c:
        return
    a
### if-return-else-return
def f():
    if x:
        return
    else:
        return
    a
### module-raise
raise X
a
def g():
    b
### dead-def
def f():
    return
    def g():
        b
    c
### decorated
@d
def f():
    pass
@d
class C:
    pass
