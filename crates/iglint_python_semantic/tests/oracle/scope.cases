    def f():
        class C:
            exec 'pass'
            y = 1
            print y
### class-exec-5
def h():
    def f():
        class C:
            exec 'pass' in d
            print y
### class-star
def h():
    def f():
        class C:
            from os import *
            print y
### class-exec-method
