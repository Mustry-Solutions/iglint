# script-library ignition/script-python/core/format in fixture-hmi (overridable=true, files=["code.py:library-module", "resource.json:resource-manifest"], missing=[])
module core.format hintScope=Some(2)
script library-module core.format scope=library enabled=true anchor=0..0 ign=-
  | def withUnit(value, unit):
  | →return "%s %s" % (value, unit)
  | 
  | 
  | def percent(value, digits=0):
  | →return ("%%.%df%%%%" % digits) % ((value or 0) * 100.0)

# script-library ignition/script-python/hmi/motors in fixture-hmi (overridable=true, files=["code.py:library-module", "resource.json:resource-manifest"], missing=[])
module hmi.motors hintScope=Some(2)
script library-module hmi.motors scope=library enabled=true anchor=0..0 ign=-
  | import core.tags
  | 
  | log = system.util.getLogger("fixture.hmi.motors")
  | 
  | 
  | def startMotor(tagPath):
  | →log.info("start %s" % tagPath)
  | →system.tag.writeBlocking([tagPath + "/Cmd/Start"], [True])
  | 
  | 
  | def isRunning(tagPath):
  | →return bool(core.tags.readOne(tagPath + "/Running", False))
  | 
  | 
  | class MotorRow(object):
  | →def __init__(self, name, speed):
  | →→self.name = name
  | →→self.speed = speed
  | 
  | →def asDict(self):
  | →→return {"name": self.name, "speed": self.speed}
  | 
  | 
  | def listMotors(line):
  | →folder = core.tags.lineFolder(line)
  | →results = system.tag.browse(folder, {"tagType": "UdtInstance"}).getResults()
  | →return [{"tagPath": str(r["fullPath"]), "title": r["name"], "selected": False} for r in results]
