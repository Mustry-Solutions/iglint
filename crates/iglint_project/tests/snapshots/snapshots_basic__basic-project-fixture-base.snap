# script-library ignition/script-python/core/format in fixture-base (overridable=true, files=["code.py:library-module", "resource.json:resource-manifest"], missing=[])
module core.format hintScope=Some(2)
script library-module core.format scope=library enabled=true anchor=0..0 ign=-
  | """Formatting helpers shared by every project."""
  | 
  | UNITS = {"rpm": "rev/min", "degC": u"\u00b0C"}
  | 
  | 
  | def withUnit(value, unit):
  | →return "%s %s" % (value, UNITS.get(unit, unit))
  | 
  | 
  | def percent(value, digits=1):
  | →if value is None:
  | →→return "-"
  | →return ("%%.%df%%%%" % digits) % (value * 100.0)

