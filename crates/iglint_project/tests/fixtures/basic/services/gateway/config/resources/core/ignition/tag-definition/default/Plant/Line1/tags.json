  },
  {
    "valueSource": "memory",
    "dataType": "Int4",
    "name": "Counter",
    "value": 0,
    "tagType": "AtomicTag",
    "eventScripts": [
      {
        "eventid": "valueChanged",
        "script": "\tif initialChange or currentValue.value is None:\n\t\treturn\n\tif currentValue.value \u003c previousValue.value:\n\t\tsystem.util.getLogger(\"fixture.tags\").warn(\"%s reset\" % tagPath)"
      },
      {
        "eventid": "qualityChanged",
        "script": "\tpass",
        "enabled": false
      }
    ],
    "alarms": [
      {
        "name": "Overflow",
        "mode": "AboveValue",
        "setpointA": 1000000.0,
        "priority": "Medium",
        "label": "Counter overflow",
        "activePipeline": "Notify"
