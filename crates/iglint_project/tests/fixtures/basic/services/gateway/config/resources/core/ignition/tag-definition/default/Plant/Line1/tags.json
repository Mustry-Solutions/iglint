  {
    "valueSource": "reference",
    "dataType": "Boolean",
    "name": "Running",
    "sourceTagPath": "[.]Motor1/Running",
    "tagType": "AtomicTag"
  },
  {
    "valueSource": "db",
    "dataType": "Int4",
    "name": "OpenOrders",
    "datasource": "Production",
    "queryType": "AutoDetect",
    "query": "SELECT COUNT(*) FROM orders WHERE line \u003d \u0027Line1\u0027",
    "executionRate": 30000,
    "executionMode": "FixedRate",
