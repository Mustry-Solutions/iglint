{
  "name": "iglint",
  "displayName": "iglint",
  "description": "Fast linter for Ignition 8.3 projects: Perspective views, Jython scripts, expressions and gateway resources.",
  "version": "0.1.1",
  "publisher": "mustry-solutions",
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mustry-Solutions/iglint"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Linters"
  ],
  "keywords": [
    "ignition",
    "perspective",
    "jython",
    "scada",
    "lint"
  ],
  "activationEvents": [
    "workspaceContains:**/project.json",
    "workspaceContains:**/iglint.toml",
    "workspaceContains:**/.iglint.toml",
    "workspaceContains:**/view.json"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "iglint",
      "properties": {
        "iglint.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path of the `iglint` binary. Empty: the binary bundled with the extension, else `iglint` on `PATH`. `${workspaceFolder}` and `~` are expanded; relative paths are relative to the first workspace folder."
        },
        "iglint.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra arguments after `iglint server`."
        },
        "iglint.run": {
          "type": "string",
          "enum": [
            "onType",
            "onSave"
          ],
          "enumDescriptions": [
            "Lint while typing.",
            "Lint when a file is opened or saved."
          ],
          "default": "onType",
          "description": "When files are linted."
        },
        "iglint.scope": {
          "type": "string",
          "enum": [
            "open",
            "workspace"
          ],
          "enumDescriptions": [
            "Show problems of open files.",
            "Show problems of every file of the workspace."
          ],
          "default": "open",
          "description": "Which files get problems."
        },
        "iglint.unsafeFixes": {
          "type": "boolean",
          "default": false,
          "description": "Also apply unsafe fixes with \"fix all\". Quick fixes always offer them, marked as unsafe."
        },
        "iglint.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the iglint language server."
        }
      }
    },
    "commands": [
      {
        "command": "iglint.restartServer",
        "title": "Restart Server",
        "category": "iglint"
      },
      {
        "command": "iglint.fixAll",
        "title": "Fix All Auto-Fixable Problems",
        "category": "iglint"
      },
      {
        "command": "iglint.showOutput",
        "title": "Show Output",
        "category": "iglint"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p . --noEmit && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "tsc -p tsconfig.test.json && node --test \"out-test/test/*.test.js\"",
    "test:integration": "npm run compile && tsc -p tsconfig.test.json && node out-test/test/integration/run.js",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.82.0",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.28.0",
    "typescript": "^5.6.0"
  }
}
