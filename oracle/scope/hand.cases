### class-exec-1
def f():
    class C:
        exec 'pass'
        print y
### class-exec-2
def h():
    def f():
        class C:
            exec 'pass'
            print y
### class-exec-3
def h():
    def f():
        class C:
            exec 'pass'
            print h
### class-exec-4
