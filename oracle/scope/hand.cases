def f():
    class C:
        from os import *
### class-star-0
class C:
    from os import *
### class-star-class
class D:
    class C:
        from os import *
### class-exec-free-method
def h():
    def f():
        class C:
            exec 'pass'
            x = 1
            def m(self):
                return x
### review-r13-mangled-import-alias
import math as _D__m

class D(object):
    x = __m.floor(3.7)
### review-r13-mangled-from-import
from math import pi as _D__pi

class D(object):
    x = __pi
### review-r13-class-reads-global-before-binding
import math as m

class C(object):
    x = m.pi
    m = 1

m = None
### review-r13-class-in-function-reads-enclosing-before-binding
def f():
    m = 1
    class C(object):
        x = m
        m = 2
    return C
### review-r13-class-in-function-reads-free
def f():
    m = 1
    class C(object):
        x = m
    return C
### review-r13-metaclass-import
import math as __metaclass__
try:
    class C:
        pass
except TypeError:
