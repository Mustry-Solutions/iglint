### global-in-nested-function-chain
def f():
    x = 1
    def g():
        global x
        def h():
            return x
        return h
    return g
### cell-through-class
def f():
    x = 1
    class C:
        x = 2
        def m(self):
            return x
    return C
### cell-class-global-between
def f():
    x = 1
    class C:
        global x
        def m(self):
            return x
    return C
