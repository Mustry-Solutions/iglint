### mangle-nested-class-names
class _A:
    class __B:
        __c = 1
        def __d(self):
            return self.__e
    def m(self):
        def __n():
            return __o
        class __P:
            __q = 1
        return self.__r
### mangle-global-in-class
class C:
    global __x, _C__y
    __x = 1
    __y = 2
    _C__y = 3
### mangle-class-reads-private-free
def f():
    __x = 1
    _C__x = 2
    class C:
        a = __x
        b = _C__x
    return C
### mangle-comprehensions-in-class
class C:
